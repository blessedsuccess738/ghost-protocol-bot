# ---- 『𝑮𝑷』 𝑮𝑯𝑶𝑺𝑻 𝑷𝑹𝑶𝑻𝑶𝑪𝑶𝑳 BOT environment template ----

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
ADMIN_IDS=123456789
OWNER_TELEGRAM_ID=123456789
ADMIN_EMAILS=admin@example.com

# Auth
ADMIN_VERIFICATION_REQUIRED=true
ADMIN_EMAIL_VERIFICATION=true
MAX_ADMINS=100
SESSION_TIMEOUT=3600

# Secrets (change in production)
SECRET_KEY=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ghostprotocolbot.com

# Notifications
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_TELEGRAM_ENABLED=true

# DB / storage
DATABASE_PATH=ghost_protocol.db
BACKUP_DIR=backups
STORAGE_DIR=storage
EXPORT_DIR=exports

# Rate limits
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW=60

# Coins / referral / force join
COIN_DEFAULT_BALANCE=0
COIN_MAX_ADD=1000000
REFERRAL_REWARD_DEFAULT=100
REFERRAL_MIN_USAGE_DEFAULT=1
REFERRAL_ENABLED_DEFAULT=true
FORCE_JOIN_ENABLED_DEFAULT=false
FORCE_JOIN_CHANNEL_DEFAULT=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
